# ---------------------------------------------------------------------------
# sevDesk (erforderlich)
# ---------------------------------------------------------------------------
# API-Token aus sevDesk: Einstellungen -> Benutzer -> API-Token
SEVDESK_API_TOKEN=

# Optional. Bleibt der Wert leer, ermittelt der Server das Bankkonto beim Start
# selbst ueber GET /CheckAccount (siehe resolveCheckAccountId). Nur setzen, wenn
# mehrere aktive Online-Bankkonten existieren und ein bestimmtes gemeint ist.
SEVDESK_CHECK_ACCOUNT_ID=

# Basis-URL der sevDesk-API. Nur aendern, wenn sevDesk die Version wechselt.
SEVDESK_BASE_URL=https://my.sevdesk.de/api/v1

# ---------------------------------------------------------------------------
# Rechnungsabruf ueber n8n (optional, aber fuer EINGANG-Belege empfohlen)
# ---------------------------------------------------------------------------
# Webhook-URL des n8n-Workflows "Find Rechnung API", also die Produktiv-URL
# aus dem Webhook-Knoten (Pfad: abrechnung/find-rechnung). Der Workflow muss in
# n8n aktiviert sein, sonst antwortet nur die Test-URL.
#
# Erwartet POST { "Rechnungsnummer": "0126/1800TG01" }
#   Der Workflow schneidet die letzten Ziffern selbst ab und sucht ueber das
#   Aktenzeichen "0126/1800TG" im OneDrive-Gutachtenordner. Steht im
#   Verwendungszweck kein Index, schickt der Server "01" mit, damit die Regex
#   des Workflows greift.
# Antwort: [{ "file": "<base64>", "filename": "0126_1800TG01_Rechnung.pdf" }]
#
# Ist die Variable leer, faellt der Server automatisch auf
# GET /Invoice/{id}/getPdf aus sevDesk zurueck - das ist die in sevDesk
# erzeugte Rechnung, nicht das unterschriebene Original aus OneDrive.
N8N_FIND_RECHNUNG_URL=

# Optionaler Header-Auth fuer den Webhook (n8n: Header Auth Credential)
N8N_WEBHOOK_AUTH_HEADER=
N8N_WEBHOOK_AUTH_VALUE=

# ---------------------------------------------------------------------------
# Belegablage in OneDrive (optional)
# ---------------------------------------------------------------------------
# Am Ende, beim Erzeugen des Abrechnungs-PDF, werden die Belege in die
# Monatsordner Konto / Bar / Tanken einsortiert. Ohne diese beiden Variablen
# zeigt die Anwendung nur die Vorschau - was wohin gehoerte - und legt nichts ab.

# Webhook: { "jahr": "26", "monat": "06" } -> Ordner-ID des Ausgabenordners
# Workflow "Find Ausgabenordner fuer Jahr und Monat" (FfLNDgPrXdV6lJe3)
N8N_ORDNER_URL=

# Webhook: { "ordnerId", "unterordner", "dateiname", "inhalt" (base64) }
# Legt die Datei im Unterordner ab. Muss noch angelegt werden.
N8N_ABLAGE_URL=

# ---------------------------------------------------------------------------
# KI-Funktionen (optional - koennen jederzeit spaeter nachgeruestet werden)
# ---------------------------------------------------------------------------
# Ohne diesen Key laeuft die App vollstaendig, nur die KI-Buttons sind inaktiv.
# Der Server meldet das ueber GET /api/capabilities an das Frontend.
ANTHROPIC_API_KEY=

# Modell fuer alle KI-Aufrufe.
ANTHROPIC_MODEL=claude-opus-5

# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# ---------------------------------------------------------------------------
# Anmeldung ueber Microsoft Entra ID (PFLICHT)
# ---------------------------------------------------------------------------
# Ohne diese Werte startet der Server nicht. Die Anwendung zeigt Kontobewegungen
# und Belege - sie darf nicht offen im Netz stehen.
# Einrichtung Schritt fuer Schritt: README, Abschnitt "Anmeldung".
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Optional. Ohne Angabe bildet der Server den Rueckweg aus der Adresse, unter
# der er aufgerufen wurde - also https://<eure-domain>/auth/callback. Diese URI
# muss in der App-Registrierung hinterlegt sein.
# Nur setzen, wenn die Anwendung intern anders heisst als nach aussen.
ENTRA_REDIRECT_URI=

# Signiert das Sitzungscookie. Mindestens 32 Zeichen.
# Erzeugen mit: openssl rand -base64 48
SESSION_SECRET=

# Optionale Einschraenkung, wer sich anmelden darf. Leer = jedes Konto des
# Tenants. Mehrere Werte durch Komma trennen.
ENTRA_ERLAUBTE_BENUTZER=
ENTRA_ERLAUBTE_GRUPPEN=

# Sitzungsdauer in Sekunden (Standard 8 Stunden)
SESSION_DAUER_SEKUNDEN=28800

# Nur fuer die lokale Arbeit ohne HTTPS auf "false" setzen.
COOKIE_SECURE=true

# NUR fuer die lokale Entwicklung: schaltet die Anmeldung komplett ab.
# Niemals in einer oeffentlich erreichbaren Umgebung setzen.
# AUTH_MODE=disabled

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
# Ablage fuer SQLite-DB, heruntergeladene Belege und erzeugte Abrechnungs-PDFs
DATA_DIR=./data
LOG_LEVEL=info
