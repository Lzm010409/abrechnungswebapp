# ---------------------------------------------------------------------------
# sevDesk (erforderlich)
# ---------------------------------------------------------------------------
# API-Token aus sevDesk: Einstellungen -> Benutzer -> API-Token
SEVDESK_API_TOKEN=

# Optional. Bleibt der Wert leer, ermittelt der Server das Bankkonto beim Start
# selbst ueber GET /CheckAccount (siehe resolveCheckAccountId). Nur setzen, wenn
# mehrere aktive Online-Bankkonten existieren und ein bestimmtes gemeint ist.
SEVDESK_CHECK_ACCOUNT_ID=

# Basis-URL der sevDesk-API. Nur aendern, wenn sevDesk die Version wechselt.
SEVDESK_BASE_URL=https://my.sevdesk.de/api/v1

# ---------------------------------------------------------------------------
# Rechnungsabruf ueber n8n (optional, aber fuer EINGANG-Belege empfohlen)
# ---------------------------------------------------------------------------
# Webhook-URL des n8n-Workflows "Find Rechnung API".
# Erwartet POST { "Rechnungsnummer": "0126/1800TG01" }
# Antwort: [{ "file": "<base64>", "filename": "0126_1800TG01_Rechnung.pdf" }]
# Ist die Variable leer, faellt der Server automatisch auf
# GET /Invoice/{id}/getPdf aus sevDesk zurueck.
N8N_FIND_RECHNUNG_URL=

# Optionaler Header-Auth fuer den Webhook (n8n: Header Auth Credential)
N8N_WEBHOOK_AUTH_HEADER=
N8N_WEBHOOK_AUTH_VALUE=

# ---------------------------------------------------------------------------
# KI-Funktionen (optional - koennen jederzeit spaeter nachgeruestet werden)
# ---------------------------------------------------------------------------
# Ohne diesen Key laeuft die App vollstaendig, nur die KI-Buttons sind inaktiv.
# Der Server meldet das ueber GET /api/capabilities an das Frontend.
ANTHROPIC_API_KEY=

# Modell fuer alle KI-Aufrufe.
ANTHROPIC_MODEL=claude-opus-5

# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
# Ablage fuer SQLite-DB, heruntergeladene Belege und erzeugte Abrechnungs-PDFs
DATA_DIR=./data
LOG_LEVEL=info
