{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  // Testcode und Testhilfen gehoeren nicht in das Produktions-Bundle.
  // Vitest transpiliert sie selbst und ist davon nicht betroffen.
  "exclude": ["src/**/*.test.ts", "src/testhilfen/**"],
  "references": [{ "path": "../shared" }]
}
